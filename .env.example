# Copy to .env and adjust. Spring reads these as environment variables; every value has a local default,
# so you only need to set what differs on your machine.

# ---- PostgreSQL (shared by all services) ----
DB_HOST=localhost
DB_PORT=5432
# DB_NAME, DB_USERNAME and DB_PASSWORD are PER SERVICE (defaults: <service>_db / <service>_service / <service>_service).
# Do not set them globally here, or every service would point at the same database.
# Set them per container in docker-compose / Kubernetes instead.

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Security ----
# Secret key for signing JWTs (at least 32 characters)
JWT_SECRET=default-jwt-secret-key-replace-in-production-nexus-exchange-32-chars
# Initial administrator account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
