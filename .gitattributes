# Normalise text files to LF in the repository; your git decides working-copy endings.
* text=auto

# Scripts that must keep specific endings
*.sh      text eol=lf
mvnw      text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary files
*.jar  binary
*.class binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.ico  binary
